# ============================================================ #
#  QueryNest — example environment (copy to .env and fill in)
#  cp .env.example .env
#
#  Never commit real keys. .env is git-ignored.
#  演示时只需配置下面前 4 项（OpenAI-compatible 供应商可共用同 1 个 Key）：
# ============================================================ #

# ---- LLM (OpenAI-compatible) ----
QUERYNEST_LLM_BASE_URL=https://api.openai.com/v1
QUERYNEST_LLM_API_KEY=sk-your-key-here
QUERYNEST_LLM_MODEL=gpt-4o-mini
# 可选：若使用另一个模型的温度 / 截断
# QUERYNEST_LLM_TEMPERATURE=0.3
# QUERYNEST_LLM_MAX_TOKENS=2048

# ---- Embedding ----
# 与 LLM 共用同一 OpenAI-compatible 供应商与 Key 时，仅需填模型名：
QUERYNEST_EMBEDDING_MODEL=text-embedding-3-small
# 向量维度（用于 LightRAG 向量库工作区隔离；与所选 embedding 模型一致）
QUERYNEST_EMBEDDING_DIM=1536
# 若 embedding 使用独立供应商 / Key，取消注释：
# QUERYNEST_EMBEDDING_BINDING_BASE_URL=https://...
# QUERYNEST_EMBEDDING_BINDING_API_KEY=...

# ---- VLM（可选，多模态图片查询时使用）----
# QUERYNEST_VLM_BASE_URL=https://...
# QUERYNEST_VLM_API_KEY=...
# QUERYNEST_VLM_MODEL=...

# ---- Reranker（可选，FlagEmbedding / BGE；留空则禁用重排）----
# QUERYNEST_RERANKER_MODEL=BAAI/bge-reranker-base
# QUERYNEST_ENABLE_RERANK=false

# ---- Parser ----
# LiteTextParser(.txt/.md) 无需重型依赖；PDF 建议 mineru（需单独安装）
QUERYNEST_PARSER=mineru
# QUERYNEST_PARSE_METHOD=auto

# ---- Storage / 服务 ----
# QUERYNEST_STORAGE_DIR=./querynest_storage
# QUERYNEST_API_HOST=0.0.0.0
# QUERYNEST_API_PORT=9621
# QUERYNEST_QUERY_TOP_K=20