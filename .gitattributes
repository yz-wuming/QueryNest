# Normalize text files to LF across all platforms
* text=auto

*.py text eol=lf
*.pyi text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.example text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bat text eol=lf
*.ps1 text eol=lf
*.log text eol=lf

# Binaries must never be mangled
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.doc binary
*.docx binary
*.xlsx binary
*.pptx binary
*.pickle binary

# Runtime / sensitive artifacts are excluded anyway
.env binary